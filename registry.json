      "download_url": "https://github.com/MicroMail-Group/Addons/releases/download/v1.0.4/antivirus-wasm.zip",
      "sha256": "209b1ac7937e8320050358c3655abc4ea88319c61ce2ee98888fcd417fa5ff31",
      "manifest": {
        "id": "official.antivirus",
        "name": "WASM Anti-Virus & Threat Scanner",
        "version": "1.0.0",
        "runtime": "backend",
        "description": "Scans attachments and email contents for malware signatures, dangerous executable payloads, and EICAR threats.",
        "permissions": [
          "hook:on_inbound_pre_store",
          "fs:read_attachment"
        ],
        "backend": {
          "wasm": "backend.wasm",
          "hooks": [
            "on_inbound_pre_store"
          ],
          "timeout_ms": 1500
        },
        "config_schema": [
          {
            "key": "block_executables",
            "type": "boolean",
            "default": true,
            "label": "Block Executable Attachments (.exe, .bat, .scr, .vbs)"
          },
          {
            "key": "action_on_threat",
            "type": "select",
            "options": [
              "reject",
              "spam"
            ],
            "default": "reject",
            "label": "Action on Threat Detected"
          }
        ]
      }
    },
